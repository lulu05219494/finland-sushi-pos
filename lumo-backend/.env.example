# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# gemini-2.5-flash has a free tier in Google AI Studio and handles vision input well.
GOOGLE_MODEL_NAME=gemini-2.5-flash

# Comma-separated list of origins allowed to call this API, e.g.:
# FRONTEND_ORIGINS=http://localhost:5500,https://your-deployed-lumo.example.com
# "*" is fine for local development only.
FRONTEND_ORIGINS=*

PORT=8000
